# ─── Supabase ───────────────────────────────────────────────────────────────
# Obtenir sur : https://supabase.com → votre projet → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Admin ──────────────────────────────────────────────────────────────────
# Mot de passe pour accéder à /admin/seances (laisser vide = pas de protection)
VITE_ADMIN_PASSWORD=votre_mot_de_passe_admin

# ─── Web3Forms (formulaire de contact) ──────────────────────────────────────
# Obtenir sur : https://web3forms.com → entrer ton email → copier l'access key
VITE_WEB3FORMS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── Instagram (feed et stats sur le portfolio) ───────────────────────────────
# Ce token est une variable secrète Cloudflare Workers (pas dans .env local)
# Pour le configurer : npx wrangler secret put INSTAGRAM_TOKEN
# Voir les instructions complètes dans README.md → section "Connexion Instagram"
# INSTAGRAM_TOKEN=IGQVJVxxx...
